# NextHire AI Backend - Base Configuration
# Common to every environment. NO SECRETS IN THIS FILE — it is committed.
# Secrets (MONGODB_URL, SECRET_KEY, ADMIN_PASSWORD) belong in the gitignored
# root .env locally, or in the host's environment when deployed.

APP_NAME="NextHire AI Backend"
APP_VERSION="1.0.0"

HOST=0.0.0.0
PORT=8002

MONGODB_DB=nexthire
MONGODB_TIMEOUT_MS=5000
MONGODB_MAX_POOL_SIZE=20

LOG_FILE=logs/app.log

ALGORITHM=HS256
# A working week.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

ADMIN_NAME="NextHire AI Admin"

# Recommendations. Jobs sent to the scorer per refresh, and the score that
# raises a "new matches" notification after a run.
GEMINI_MODEL=gemini-2.5-flash
RECOMMENDATION_BATCH_SIZE=15
RECOMMENDATION_NOTIFY_SCORE=70

# Collection.
SCHEDULER_TICK_SECONDS=60
COLLECTION_LOCK_MINUTES=15
JOB_STALE_AFTER_DAYS=30
COLLECTION_MAX_JOBS_PER_RUN=500
CONNECTOR_TIMEOUT_SECONDS=20
