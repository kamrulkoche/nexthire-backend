# NextHire AI Backend - Production overrides
# Still no secrets: MONGODB_URL, SECRET_KEY and ADMIN_PASSWORD come from the
# host environment.

ENVIRONMENT=prod
DEBUG=false
LOG_LEVEL=WARNING

# The deployed Next.js origin. Must be exact — allow_credentials forbids "*".
CORS_ORIGINS=["https://www.nexthire.example"]

# Create the first admin once, deliberately, then set this back to false so a
# restart can never recreate a deactivated account.
SETUP_ADMIN=false

# Exactly one API process runs the scheduler. Set SCHEDULER_ENABLED=false on
# any additional replica in the host's environment.
SCHEDULER_ENABLED=true
