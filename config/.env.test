# NextHire AI Backend - Test overrides (tests/conftest.py sets ENVIRONMENT=test).
# The suite builds its own in-memory (mongomock) databases; nothing here
# points at a real MongoDB.

ENVIRONMENT=test
DEBUG=false
LOG_LEVEL=WARNING
LOG_FILE=
MONGODB_URL=mongodb://test-suite-never-connects:1
MONGODB_DB=nexthire_test
SETUP_ADMIN=false
CORS_ORIGINS=["http://localhost:3003"]
# Test-only signing key: long enough for HS256 so PyJWT does not warn. It signs
# nothing outside the suite.
SECRET_KEY=test-only-signing-key-never-used-outside-the-suite
# Never start the scheduler or call Gemini from the suite.
SCHEDULER_ENABLED=false
GEMINI_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
