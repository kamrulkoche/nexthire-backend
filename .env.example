# Copy this file to `.env` in this directory and fill in the real values.
# `.env` is gitignored — never commit real credentials.
#
# Loading order (later wins): config/.env.base -> config/.env.{ENVIRONMENT} -> .env

# dev | prod. Outside dev the app refuses the placeholder SECRET_KEY and refuses
# to boot against an out-of-date schema.
ENVIRONMENT=dev
DEBUG=true
LOG_LEVEL=INFO

# MongoDB — start it with `docker compose up -d mongo` (host port 27018).
# The credentials match MONGO_INITDB_ROOT_* in docker-compose.yml.
# If the password contains @ : / ? # or %, URL-encode it (@ -> %40).
MONGODB_URL=mongodb://nexthire:nexthire@localhost:27018/?authSource=admin
MONGODB_DB=nexthire

# Signs every access token. Changing it signs everyone out.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# The Next.js site's origin (nexthire-frontend runs on 3003).
CORS_ORIGINS=["http://localhost:3003"]

# Initial admin — created on startup only if absent, never overwritten.
SETUP_ADMIN=true
ADMIN_EMAIL=admin@nexthire.dev
ADMIN_PASSWORD=
ADMIN_NAME=NextHire AI Admin

# ---------------------------------------------------------------------------
# Gemini — server-side only. Without a key, recommendations use the built-in
# keyword scorer instead (labelled "heuristic" in the app).
#   https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Scheduled collection. Turn off on every API process but one.
# ---------------------------------------------------------------------------
SCHEDULER_ENABLED=true

# ---------------------------------------------------------------------------
# Adzuna — only needed for sources of type `adzuna`.
#   https://developer.adzuna.com/
# ---------------------------------------------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Password given to the demo seeker by scripts/seed_demo_data.py (dev only).
DEMO_SEEKER_PASSWORD=

# ---------------------------------------------------------------------------
# Lead Finder — Google Maps Platform, Places API (New). Server-side only.
#   https://console.cloud.google.com/apis/library/places.googleapis.com
# Enable "Places API (New)" on the key; restrict it to that API (and, in
# production, to this server's IP). The browser's map uses a SEPARATE key
# (NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY in nexthire-frontend/.env.local).
# ---------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=
# Days Google content (name, phone, website, ...) is kept before the
# scheduler wipes it; place IDs are kept. Check the Google Maps Platform terms
# for your account before raising this.
LEAD_CONTENT_TTL_DAYS=30
# Defaults for the admin-editable quotas (Admin -> Lead Finder).
LEAD_DAILY_REQUEST_QUOTA=300
LEAD_MAX_REQUESTS_PER_SEARCH=90

# Sign-in / registration attempt limits ("Too many attempts"). false switches them
# off for local development only; ignored unless ENVIRONMENT is dev or test.
# AUTH_RATE_LIMIT_ENABLED=true
